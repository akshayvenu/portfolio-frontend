# Public origin of the deployed site.
# Drives canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL="https://akshayvenu.com"

# Origin of the FastAPI backend (see ../backend). Used server-side only, to
# fetch the training snapshot for the Side Quest page.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Strava (Side Quest page). Single-athlete OAuth app from
# https://www.strava.com/settings/api — the refresh token needs the
# `activity:read_all` scope. Leave unset to render seeded sample data.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REFRESH_TOKEN=""
# Time zone used for "today", streaks and the calendar (IANA name).
STRAVA_TIMEZONE="Asia/Kolkata"
